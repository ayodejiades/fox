# Copy to .env and fill in. Never commit .env — see .gitignore.

# Set to 1 to run entirely offline against on-disk fixtures (see fixtures/, lib/demo-mode.*).
# The dashboard's meter state is always in-memory only — there is no database in this
# project — so DEMO_MODE only controls whether the on-chain settlement bridge script talks
# to a real chain or replays fixtures/settlement-fixture.json instead.
DEMO_MODE=0

# Where this app is deployed once `make deploy` has run — used by the keepalive workflow
# and by the Playwright demo recorder.
DEPLOY_URL=http://localhost:3000

# --- on-chain settlement bridge (scripts/settle.ts) — see AGENTS.md Phase 4 ---

# RPC endpoint. Free: https://forno.celo.org (mainnet) or https://forno.celo-sepolia.celo-testnet.org (testnet).
CELO_RPC_URL=https://forno.celo-sepolia.celo-testnet.org

# Seller's private key. Test keys only — never a funded mainnet key in this file or .env.
SELLER_PRIVATE_KEY=

# Buyer's private key, used ONLY to sign off-chain window attestations in the demo script —
# a real buyer would sign with its own wallet, never hand this key to the seller.
BUYER_PRIVATE_KEY=

# Deployed FoX contract address (see contracts/README.md for the deploy script).
FOX_CONTRACT_ADDRESS=

# ERC20 token address used for settlement (a MockUSD you deploy yourself on testnet, or a
# real cUSD/cNGN/USA₮ address on mainnet).
FOX_TOKEN_ADDRESS=
